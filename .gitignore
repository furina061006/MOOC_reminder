# Dependencies
node_modules/

# 运行时输出。注意 `logs/` 会匹配任意层级的 logs 目录，所以下面必须把
# .dsh/logs/ 显式放行——否则新写的开发日志会被静默忽略（2026-09-21 真的丢过一批）。
logs/

# .dsh/ 是项目文档目录：只跟踪 logs/（历史与更新日志）和 agents/（分主题知识库），
# 其余任何东西（各工具的本机 settings 等）一律不进仓库。
.dsh/*
!.dsh/logs/
!.dsh/logs/**
!.dsh/agents/
!.dsh/agents/**

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build output
dist/
build/
mooc-reminder*.zip

# Environment
.env
.env.local

# AI 工具的本机目录 —— 仓库不再使用 .claude/（2026-09-21 已把里面有用的东西折进
# AGENTS.md / .dsh/agents/，目录整个删掉）。这条规则只是安全带：以后谁再跑 Claude Code
# 或别的兼容工具，它自动生成的 settings 不会被顺手提交。
.claude/

# reference projects
reference_projects/

# zcode —— AI 规划工具的本地目录。这条规则以前写成 `zcode/`（少了点），
# 挡不住真实目录，于是 `.zcode/plans/*.md` 曾被提交进仓库（2026-09-21 已 git rm）。
.zcode/

# Local diagnostic dumps — raw DOM snapshots and API captures contain the user's
# own course/account data (userId, course ids, teacher content) and this repo is
# public. See tools/diagnostics/README.md.
element.txt
mooc-dto-report.json
dto*.json
*-report.json
*.har
