# Dependencies
node_modules/

# Logs (runtime output)
logs/
# ...but .claude/logs/ is NOT runtime output: it holds the developer docs that
# CLAUDE.md links to (changelog.md, architecture.md, dated dev logs). Without these
# negations `logs/` silently swallows every new file written there — several dev
# logs were already lost that way.
!.claude/logs/
!.claude/logs/**

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build output
dist/
build/
mooc-reminder.zip

# Environment
.env
.env.local

# Local settings (may contain sensitive paths)
.claude/settings.local.json

# reference projects
reference_projects/

# zcode
zcode/

# Local diagnostic dumps — raw DOM snapshots and API captures contain the user's
# own course/account data (userId, course ids, teacher content) and this repo is
# public. See tools/diagnostics/README.md.
element.txt
mooc-dto-report.json
dto*.json
*-report.json
*.har
